{
  "name": "apuestas-deportivas-backend",
  "version": "1.0.0",
  "description": "API REST para simulación de apuestas deportivas con créditos virtuales",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test tests/unit.test.js",
    "test:eventos": "jest --runInBand --runTestsByPath tests/eventos_deportivos.responsable2.test.js",
    "lint:eventos": "eslint --config eslint.responsable2.config.cjs src/app.js src/services/bettingService.js tests/eventos_deportivos.responsable2.test.js eslint.responsable2.config.cjs --max-warnings 0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
